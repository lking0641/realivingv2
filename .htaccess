RewriteEngine On

# ─── Block iframe embedding ───────────────────────────────────────
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "frame-ancestors 'self'"

# ─── Browser caching for static assets ────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|mp4|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ─── Text compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Allow OPTIONS preflight ──────────────────────────────────────
RewriteCond %{REQUEST_METHOD} ^OPTIONS$
RewriteRule ^ - [L]

# ─── Passthrough upload scripts ───────────────────────────────────
RewriteCond %{REQUEST_URI} (chunk_upload|direct_upload|attachment_chunk_upload|attachment_direct_upload)\.php [NC]
RewriteRule ^ - [L]

# ─── Allow direct access to real files/folders ───────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ─── Route everything else to index.php ──────────────────────────
RewriteRule ^(.*)$ index.php [QSA,L]